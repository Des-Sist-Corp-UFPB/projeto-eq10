# ══════════════════════════════════════════════════════════════════════════════
# Configuração da aplicação SIA/DATASUS — EQ10
# Copie este arquivo como .env e preencha os valores necessários.
# NUNCA faça commit do .env com credenciais reais.
# ══════════════════════════════════════════════════════════════════════════════

# ── Banco de dados — ETL (pipeline main.py via src/load.py) ─────────────────
# Credenciais no formato original lido por src/load.py
user=seu-usuario-db
password=sua-senha-db
host=seu-host-postgres
database=nome-do-banco

# ── Banco de dados da aplicação/autenticação (gravável) ─────────────────────
# Use AUTH_DATABASE_URL OU o grupo completo AUTH_DB_*.
# Armazena usuarios, auditoria, tokens, cadastros pendentes e historico de chat.
# AUTH_DATABASE_URL=postgresql+psycopg2://app_user:senha@auth-db.example.com:5432/app_db?sslmode=require
AUTH_DB_USER=app_user
AUTH_DB_PASSWORD=senha-aqui
AUTH_DB_HOST=auth-db.example.com
AUTH_DB_PORT=5432
AUTH_DB_NAME=app_db
AUTH_DB_SSLMODE=disable

# ── Banco de dados analítico (leitura para a camada de IA) ───────────────────
# Use AI_DATABASE_URL OU o grupo completo AI_DB_*.
# Deve apontar para a base DATASUS readonly.
# AI_DATABASE_URL=postgresql+psycopg2://ia_readonly:senha@analytics-db.example.com:5432/analytics?sslmode=require
AI_DB_USER=ia_readonly
AI_DB_PASSWORD=senha-aqui
AI_DB_HOST=seu-host-postgres
AI_DB_PORT=5432
AI_DB_NAME=nome-do-banco

# Modo SSL da conexão PostgreSQL:
#   'require'  → Neon, RDS, ou qualquer PostgreSQL na nuvem com SSL obrigatório
#   'prefer'   → PostgreSQL que aceita mas não exige SSL
#   'disable'  → PostgreSQL interno Docker (host 'postgres' na mesma rede)
AI_DB_SSLMODE=require

# ── Configuração da IA ────────────────────────────────────────────────────────
# AI_USE_LLM: true para usar LLM externo, false para modo estatístico simples
AI_USE_LLM=true
AI_FALLBACK_TO_SIMPLE=true
AI_DEBUG_SAFE=false

# Provedor de LLM:
#   'openai'      → OpenAI API direta OU qualquer proxy OpenAI-compatível
#   'openrouter'  → OpenRouter (acesso a múltiplos modelos)
#   'gemini'      → Google Gemini
AI_LLM_PROVIDER=openai

# Modelo:
#   openai/proxy  → gpt-4o-mini, gpt-4o, gpt-4.1-mini
#   openrouter    → openrouter/openrouter/auto, openrouter/google/gemini-flash-1.5
#   gemini        → gemini/gemini-2.5-flash, gemini/gemini-2.0-flash-lite
AI_LLM_MODEL=gpt-4o-mini

# Chave de API do provedor escolhido
AI_LLM_API_KEY=sua-api-key-aqui

# URL base do endpoint (deixe vazio para usar a URL padrão do provedor).
# Use esta variável para apontar para um proxy OpenAI-compatível:
#   Exemplo (professor): AI_LLM_BASE_URL=https://llm.rodrigor.com/v1
#   Exemplo (LM Studio): AI_LLM_BASE_URL=http://localhost:1234/v1
# IMPORTANTE: inclua sempre o /v1 no final do endpoint.
AI_LLM_BASE_URL=

# ── Armazenamento de objetos S3/MinIO (opcional) ─────────────────────────────
# Necessário apenas se a aplicação precisar armazenar arquivos (ex: parquets).
# Endpoint interno (dentro da rede Docker): http://minio:9000
# Endpoint público: https://s3.dsc.rodrigor.com
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=https://s3.dsc.rodrigor.com
# S3_BUCKET=eq10
# S3_ACCESS_KEY=eq10
# S3_SECRET_KEY=sua-secret-key
# S3_REGION=us-east-1

# ── E-mail (opcional) ─────────────────────────────────────────────────────────
# EMAIL_ENABLED: true para envio real, false para modo fake (desenvolvimento)
EMAIL_ENABLED=
EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_USE_TLS=

# SMTP (Gmail, SendGrid SMTP, etc.)
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=seu-email@gmail.com
# EMAIL_SMTP_PASSWORD=sua-senha-de-app
# EMAIL_USE_TLS=true

# ── URL pública da aplicação ──────────────────────────────────────────────────
# Necessária para links enviados por e-mail (verificação, reset de senha)
APP_PUBLIC_BASE_URL=http://localhost:8080

# Observabilidade OpenTelemetry (opcional; nenhum segredo deve ser commitado)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=dsc-eq10
OTEL_RESOURCE_ATTRIBUTES=service.namespace=dsc,deployment.environment=development
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# Em producao, configure fora do repositorio:
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <credencial-base64>
OTEL_EXPORTER_OTLP_TIMEOUT=10000

