FROM python:3.11-slim

# Evita arquivos .pyc e força saída sem buffer.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# ── Instalador Python ──────────────────────────────────────────────────────────
COPY --from=ghcr.io/astral-sh/uv:0.5.31 /uv /uvx /usr/local/bin/

# ── Dependências de sistema ────────────────────────────────────────────────────
# Instalamos nginx aqui para aproveitar o cache de camada junto com apt.
# O `rm -rf /var/lib/apt/lists/*` remove o índice de pacotes depois do install,
# liberando ~50 MB de disco.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/*

# ── Dependências Python ────────────────────────────────────────────────────────
# Copiamos só o requirements.txt antes do resto do código para que o Docker
# possa reaproveitar a camada quando o código mudar mas as dependências não.
# O chat usa requirements.txt porque o uv.lock atual ainda não lista todas as
# dependências do app Streamlit.
COPY requirements.txt ./
RUN uv venv "$UV_PROJECT_ENVIRONMENT" \
    && uv pip install --python "$UV_PROJECT_ENVIRONMENT/bin/python" -r requirements.txt \
    && find "$UV_PROJECT_ENVIRONMENT" -name "__pycache__" -type d -prune -exec rm -rf {} +

# ── Código da aplicação ────────────────────────────────────────────────────────
COPY app_ai_chat.py ./
COPY .streamlit ./.streamlit
COPY loadtest ./loadtest
COPY scripts ./scripts
COPY src ./src
COPY nginx.conf /etc/nginx/nginx.conf
COPY start.sh ./
RUN sed -i 's/\r$//' start.sh && chmod +x start.sh

EXPOSE 8080 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
    CMD /app/.venv/bin/python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/ping', timeout=5).read()"

CMD ["./start.sh"]
