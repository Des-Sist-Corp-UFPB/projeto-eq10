FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN python -m pip install --upgrade pip \
    && python -m pip install \
        streamlit \
        pandas \
        sqlalchemy \
        psycopg2-binary \
        python-dotenv \
        pandasai \
        pandasai-litellm

COPY app_ai_chat.py ./
COPY scripts ./scripts
COPY src ./src

EXPOSE 8080

CMD ["python", "-m", "streamlit", "run", "app_ai_chat.py", "--server.address=0.0.0.0", "--server.port=8080"]
