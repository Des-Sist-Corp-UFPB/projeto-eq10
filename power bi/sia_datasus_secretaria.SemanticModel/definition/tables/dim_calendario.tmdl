	column 'Nome do Dia'
		lineageTag: d12118b6-d3b6-4d85-8647-26476d034668
		summarizeBy: none
		isNameInferred
		sourceColumn: [Nome do Dia]

		annotation SummarizationSetBy = Automatic

	partition dim_calendario = calculated
		mode: import
		source =
				
				VAR DataMinima = MIN('public data_sus'[data])
				VAR DataMaxima = MAX('public data_sus'[data])
				RETURN
				ADDCOLUMNS (
				    CALENDAR(DataMinima, DataMaxima),
				    "Ano", YEAR([Date]),
				    "Mês Num", MONTH([Date]),
				    "Mês Nome", FORMAT([Date], "MMMM"),
				    "Mês Abrev", FORMAT([Date], "MMM"),
				    "Trimestre", "T" & QUARTER([Date]),
				    "Ano-Mês", FORMAT([Date], "YYYY-MM"),
				    "Dia da Semana", WEEKDAY([Date], 2),
				    "Nome do Dia", FORMAT([Date], "dddd")
				)

	annotation PBI_Id = 1343fa470e4f473dad5119bcbed186a3

