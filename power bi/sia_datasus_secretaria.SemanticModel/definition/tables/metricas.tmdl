			VAR UltimaDataComValor =
			    MAXX(
			        FILTER(
			            ALLSELECTED(dim_calendario),
			            NOT ISBLANK([total_frequencia])
			        ),
			        dim_calendario[Date]
			    )
			
			RETURN
			CALCULATE(
			    [total_frequencia],
			    dim_calendario[Date] = UltimaDataComValor
			)
		displayFolder: Tabelas_Comp
		lineageTag: 346d8862-7176-47aa-b360-1e97d02c74f2

		formatStringDefinition = ```
				var medida = SELECTEDMEASURE()
				var formato = SWITCH(
				    TRUE(),
				    medida >= 1000000, "#,,. Mi",
				    medida >=1000, "#,. Mil",
				    "#"
				)
				return 
				formato
				```

	measure total_FRE_tabela_variação =
			
			var varicao = DIVIDE([total_FRE_tabela_ultimo_mes] - [total_FRE_tabela_penultimo_mes], [total_FRE_tabela_penultimo_mes])
			var _format = FORMAT(varicao, "↑0.00% ; ↓0.00%")
			return
			_format
		displayFolder: Tabelas_Comp
		lineageTag: bcaf4423-7aee-400d-84b8-4b5c2e96125e

	measure atualização_dados =
			
			var data_atualizacao = CALCULATE(max(dim_calendario[Date]), all(dim_calendario))
			var data_formatada = FORMAT(data_atualizacao, "dd/mm/yyyy")
			return data_formatada
		lineageTag: ea6b23af-9dab-4a25-81e1-59559c0794c2

	measure total_VP_tabela_mes_ano_passado =
			
			VAR DataMaxima = MAX(dim_calendario[Date])
			
			
			VAR InicioMes = DATE(YEAR(DataMaxima), MONTH(DataMaxima), 1)
			VAR FimMes = EOMONTH(DataMaxima, 0)
			var valor_mes_ano_passado = CALCULATE(
			    [total_valor_aprovado],
			    SAMEPERIODLASTYEAR(
			        DATESBETWEEN(
			            dim_calendario[Date],
			            InicioMes,
			            FimMes
			        )
			    )
			)
			
			RETURN
			valor_mes_ano_passado
		displayFolder: Tabelas_Comp
		lineageTag: 9a6491a2-1fc4-49e9-b167-972358416a77

		formatStringDefinition = ```
				var medida = SELECTEDMEASURE()
				var formato = SWITCH(
				    TRUE(),
				    medida >= 1000000, "R$#,,.0 Mi",
				    medida >=1000, "R$#,.0 Mil",
				    "R$#.0"
				)
				return 
				formato
				```

	measure total_VP_tabela_variação_ano_passado =
			
			var varicao = DIVIDE([total_VP_tabela_ultimo_mes] - [total_VP_tabela_mes_ano_passado], [total_VP_tabela_mes_ano_passado])
			var _format = FORMAT(varicao, "↑0.00% ; ↓0.00%")
			return
			_format
		displayFolder: Tabelas_Comp
		lineageTag: b75a6322-25bd-4943-98c2-b4d9cc5c6f67

