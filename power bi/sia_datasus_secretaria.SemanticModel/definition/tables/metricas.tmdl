	measure titulo_VP_mes_dinamico =
			
			var valor = SELECTEDMEASURE()
			var mes = SELECTEDVALUE(dim_calendario[Date].[Mês])
			var titulo = "Total do mes " & mes & ": " & valor
			return titulo
		lineageTag: a9e409d8-e204-4f68-a3b0-4374d4230541

	measure total_VP_YOY = ```
			
			-- Calcula o valor do mesmo período no ano anterior (Last Year)
			-- Usa SAMEPERIODLASTYEAR respeitando o contexto atual de datas
			VAR total_ly = 
			    CALCULATE(
			        [total_valor_aprovado],
			        SAMEPERIODLASTYEAR(dim_calendario[Date])
			    )
			
			-- Calcula o valor atual
			VAR valor_atual = 
			    IF(
			        -- Se NÃO houver filtro de ano (caso do TOTAL)
			        SELECTEDVALUE('dim_calendario'[Ano]) = BLANK(),
			
			        -- Força pegar apenas o último ano disponível (evita somar anos históricos)
			        CALCULATE(
			            [total_valor_aprovado],
			            dim_calendario[Ano] = MAX('dim_calendario'[Ano])
			        ),
			
			        -- Caso tenha filtro de ano, usa o valor normalmente
			        [total_valor_aprovado]
			    )
			var YOY = DIVIDE(valor_atual - total_ly, total_ly)
			var _format = FORMAT(YOY, "↑0.00% ; ↓0.00%")
			 
			-- Retorna o cálculo de crescimento YoY
			RETURN 
			_format
			```
		displayFolder: Cards
		lineageTag: 529b0c28-fc55-4db1-8597-9b2b5803ed30

	measure total_VP_MOM = ```
			
			
			-- Pega o ano mais recente disponível no contexto (ou no total)
			VAR AnoAtual = MAX('dim_calendario'[Ano])
			
			-- Dentro do AnoAtual, pega o último mês disponível (evita misturar meses de outros anos)
			VAR MesAtual =
			    CALCULATE(
			        MAX('dim_calendario'[Mês Num]),
			        'dim_calendario'[Ano] = AnoAtual
			    )
			
			-- Define o mês anterior com tratamento de virada de ano (Jan → Dez)
			VAR MesAnterior =
			    IF(MesAtual = 1, 12, MesAtual - 1)
			
			-- Define o ano do mês anterior (se Jan, volta um ano)
			VAR AnoAnterior =
			    IF(MesAtual = 1, AnoAtual - 1, AnoAtual)
			
			-- Calcula o valor do mês anterior (LM = Last Month)
			VAR total_lm =
			    IF(
			        -- Se NÃO há filtro de ano nem mês (caso de TOTAL do visual)
			        AND(
			            ISBLANK(SELECTEDVALUE(dim_calendario[Ano])),
			            ISBLANK(SELECTEDVALUE(dim_calendario[Mês Nome]))
			        ),
			        -- Calcula manualmente o mês anterior com base no último período disponível
			        CALCULATE(
			            [total_valor_aprovado],
			            'dim_calendario'[Ano] = AnoAnterior,
			            'dim_calendario'[Mês Num] = MesAnterior
			        ),
			        -- Caso haja filtro (linha, gráfico, etc), usa o comportamento padrão de time intelligence
			        CALCULATE(
			            [total_valor_aprovado],
			            DATEADD(dim_calendario[Date], -1, MONTH)
			        )
			    )
			
			-- Calcula o valor atual
			VAR valor_atual =
			    IF(
			        -- Se NÃO há filtro de ano nem mês (caso de TOTAL)
			        AND(
			            ISBLANK(SELECTEDVALUE(dim_calendario[Ano])),
			            ISBLANK(SELECTEDVALUE(dim_calendario[Mês Nome]))
			        ),
			        -- Força pegar apenas o último mês disponível do último ano
			        CALCULATE(
			            [total_valor_aprovado],
			            'dim_calendario'[Ano] = AnoAtual,
			            'dim_calendario'[Mês Num] = MesAtual
			        ),
			        -- Caso normal (com filtro), usa a medida padrão
			        [total_valor_aprovado]
			    )
			
			-- Retorna o cálculo de crescimento mês contra mês (MoM)
			var MOM = DIVIDE(valor_atual - total_lm, total_lm)
			var _format = FORMAT(MOM, "↑0.00% ; ↓0.00%")
			RETURN 
			_format
			
			```
		displayFolder: Cards
		lineageTag: 63fbb42f-59c6-4343-98ca-3ce340c2ee22

	measure total_VP_Card =
			
			var medida = [total_valor_aprovado]
			var formato = SWITCH(
			    TRUE(),
			    medida >= 1000000, FORMAT(medida, "R$#,,.0 Mi"),
			    medida >= 1000, FORMAT(medida,"R$#,.0 Mil"),
			    FORMAT(medida,"R$#.0")
			)
			return formato
		displayFolder: Cards
		lineageTag: de8dd9d4-9984-489c-95ff-f1c6ce36e6bf

