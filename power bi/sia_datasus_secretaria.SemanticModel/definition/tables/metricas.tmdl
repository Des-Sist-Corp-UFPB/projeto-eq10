	measure total_VP_tabela_ultimo_mes =
			
			VAR UltimaDataComValor =
			    MAXX(
			        FILTER(
			            ALLSELECTED(dim_calendario),
			            NOT ISBLANK([total_valor_aprovado])
			        ),
			        dim_calendario[Date]
			    )
			
			RETURN
			CALCULATE(
			    [total_valor_aprovado],
			    dim_calendario[Date] = UltimaDataComValor
			)
		displayFolder: Tabelas_Comp
		lineageTag: 5a503696-5491-457b-a6b5-630e6e89dbe5

		formatStringDefinition = ```
				var medida = SELECTEDMEASURE()
				var formato = SWITCH(
				    TRUE(),
				    medida >= 1000000, "R$#,,.0 Mi",
				    medida >=1000, "R$#,.0 Mil",
				    "R$#.0"
				)
				return 
				formato
				```

	measure total_VP_tabela_penultimo_mes =
			
			VAR TabelaUltimos2 =
			    TOPN(
			        2,
			        FILTER(
			            ALLSELECTED(dim_calendario),
			            NOT ISBLANK([total_valor_aprovado])
			        ),
			        dim_calendario[Date],
			        DESC
			    )
			
			VAR PenultimaData =
			    MINX(TabelaUltimos2, dim_calendario[Date])
			
			RETURN
			CALCULATE(
			    [total_valor_aprovado],
			    dim_calendario[Date] = PenultimaData
			)
		displayFolder: Tabelas_Comp
		lineageTag: c0adcc50-6dac-498f-af38-f4fddd9af52d

		formatStringDefinition = ```
				var medida = SELECTEDMEASURE()
				var formato = SWITCH(
				    TRUE(),
				    medida >= 1000000, "R$#,,.0 Mi",
				    medida >=1000, "R$#,.0 Mil",
				    "R$#.0"
				)
				return 
				formato
				```

	measure total_VP_tabela_variação =
			
			var varicao = DIVIDE([total_VP_tabela_ultimo_mes] - [total_VP_tabela_penultimo_mes], [total_VP_tabela_penultimo_mes])
			var _format = FORMAT(varicao, "↑0.00% ; ↓0.00%")
			return
			_format
		displayFolder: Tabelas_Comp
		lineageTag: 111f329d-eab8-4b97-8e4c-bba0a121b41d

	measure total_FRE_tabela_penultimo_mes =
			
			VAR TabelaUltimos2 =
			    TOPN(
